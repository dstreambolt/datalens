{
  "dashboard": {
    "title": "DStreamBolt Real-Time Analytics",
    "tags": ["dstreambolt", "spark", "kafka", "realtime"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Requests Per Minute",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "rawSql": "SELECT window_start as time, SUM(request_count) as value FROM status_summary WHERE window_start >= NOW() - INTERVAL 1 HOUR GROUP BY window_start ORDER BY window_start",
            "format": "time_series",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisLabel": "Requests",
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "short"
          }
        },
        "options": {
          "tooltip": {"mode": "multi"},
          "legend": {"displayMode": "list", "placement": "bottom"}
        }
      },
      {
        "id": 2,
        "title": "Error Rate",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "rawSql": "SELECT window_start as time, SUM(CASE WHEN status >= 400 THEN request_count ELSE 0 END) * 100.0 / SUM(request_count) as value FROM status_summary WHERE window_start >= NOW() - INTERVAL 1 HOUR GROUP BY window_start ORDER BY window_start",
            "format": "time_series",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "custom": {
              "axisLabel": "Error %",
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 20
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 5, "color": "yellow"},
                {"value": 10, "color": "red"}
              ]
            },
            "unit": "percent"
          }
        }
      },
      {
        "id": 3,
        "title": "Status Code Distribution",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
        "targets": [
          {
            "rawSql": "SELECT status as metric, SUM(request_count) as value FROM status_summary WHERE window_start >= NOW() - INTERVAL 15 MINUTE GROUP BY status ORDER BY value DESC",
            "format": "table",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]},
          "pieType": "pie",
          "tooltip": {"mode": "single"}
        }
      },
      {
        "id": 4,
        "title": "Average Response Time",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
        "targets": [
          {
            "rawSql": "SELECT AVG(avg_response_time) as value FROM status_summary WHERE window_start >= NOW() - INTERVAL 5 MINUTE",
            "format": "table",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "auto",
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 0.5, "color": "yellow"},
                {"value": 1.0, "color": "orange"},
                {"value": 2.0, "color": "red"}
              ]
            },
            "unit": "s",
            "min": 0,
            "max": 3
          }
        }
      },
      {
        "id": 5,
        "title": "Current Requests/sec",
        "type": "stat",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
        "targets": [
          {
            "rawSql": "SELECT SUM(request_count) / (UNIX_TIMESTAMP(MAX(window_end)) - UNIX_TIMESTAMP(MIN(window_start))) as value FROM status_summary WHERE window_start >= NOW() - INTERVAL 1 MINUTE",
            "format": "table",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value",
          "orientation": "auto",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 100, "color": "yellow"},
                {"value": 500, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 6,
        "title": "Top 10 Slowest Endpoints",
        "type": "table",
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "rawSql": "SELECT endpoint, method, ROUND(AVG(avg_response_time), 3) as avg_response_time, ROUND(AVG(p95_response_time), 3) as p95_response_time, ROUND(AVG(p99_response_time), 3) as p99_response_time, SUM(request_count) as requests FROM endpoint_summary WHERE window_start >= NOW() - INTERVAL 15 MINUTE GROUP BY endpoint, method ORDER BY avg_response_time DESC LIMIT 10",
            "format": "table",
            "refId": "A"
          }
        ],
        "options": {
          "showHeader": true
        },
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "avg_response_time"},
              "properties": [{"id": "unit", "value": "s"}]
            },
            {
              "matcher": {"id": "byName", "options": "p95_response_time"},
              "properties": [{"id": "unit", "value": "s"}]
            },
            {
              "matcher": {"id": "byName", "options": "p99_response_time"},
              "properties": [{"id": "unit", "value": "s"}]
            }
          ]
        }
      },
      {
        "id": 7,
        "title": "Top 10 Most Requested Endpoints",
        "type": "barchart",
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 16},
        "targets": [
          {
            "rawSql": "SELECT CONCAT(method, ' ', endpoint) as metric, SUM(request_count) as value FROM endpoint_summary WHERE window_start >= NOW() - INTERVAL 15 MINUTE GROUP BY endpoint, method ORDER BY value DESC LIMIT 10",
            "format": "table",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "xTickLabelRotation": 0,
          "xTickLabelSpacing": 100,
          "showValue": "always",
          "legend": {"displayMode": "hidden"}
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 8,
        "title": "Response Time Percentiles (Last 15min)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 26},
        "targets": [
          {
            "rawSql": "SELECT window_start as time, AVG(avg_response_time) as 'avg', AVG(p95_response_time) as 'p95', AVG(p99_response_time) as 'p99' FROM endpoint_summary WHERE window_start >= NOW() - INTERVAL 15 MINUTE GROUP BY window_start ORDER BY window_start",
            "format": "time_series",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisLabel": "Response Time",
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 0
            },
            "unit": "s"
          }
        },
        "options": {
          "tooltip": {"mode": "multi"},
          "legend": {"displayMode": "list", "placement": "bottom"}
        }
      },
      {
        "id": 9,
        "title": "Error Analysis (Status >= 400)",
        "type": "table",
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 34},
        "targets": [
          {
            "rawSql": "SELECT status, endpoint, method, SUM(error_count) as total_errors, ROUND(AVG(avg_response_time), 3) as avg_response_time, window_start FROM endpoint_summary WHERE error_count > 0 AND window_start >= NOW() - INTERVAL 1 HOUR GROUP BY status, endpoint, method, window_start ORDER BY total_errors DESC, window_start DESC LIMIT 50",
            "format": "table",
            "refId": "A"
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": [{"displayName": "total_errors", "desc": true}]
        },
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "status"},
              "properties": [
                {
                  "id": "custom.width",
                  "value": 80
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "thresholds"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {"value": 400, "color": "yellow"},
                      {"value": 500, "color": "red"}
                    ]
                  }
                }
              ]
            },
            {
              "matcher": {"id": "byName", "options": "avg_response_time"},
              "properties": [{"id": "unit", "value": "s"}]
            }
          ]
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  },
  "overwrite": true
}

