{
  "dashboard": {
    "title": "DStreamBolt Customer Analytics",
    "tags": ["dstreambolt", "customer", "analytics", "traffic"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Total Requests (Last Hour)",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "rawSql": "SELECT SUM(request_count) as value FROM dstreambolt_metrics.status_summary WHERE window_start >= NOW() - INTERVAL 1 HOUR",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "blue"},
                {"value": 1000, "color": "green"},
                {"value": 10000, "color": "yellow"}
              ]
            },
            "unit": "short"
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "orientation": "auto"
        }
      },
      {
        "id": 2,
        "title": "Error Rate %",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "rawSql": "SELECT (SUM(error_count) * 100.0 / SUM(request_count)) as value FROM dstreambolt_metrics.status_summary WHERE window_start >= NOW() - INTERVAL 1 HOUR",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            },
            "unit": "percent"
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "id": 3,
        "title": "Avg Response Time",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "rawSql": "SELECT AVG(avg_response_time) as value FROM dstreambolt_metrics.status_summary WHERE window_start >= NOW() - INTERVAL 1 HOUR",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 0.5, "color": "yellow"},
                {"value": 1.0, "color": "red"}
              ]
            },
            "unit": "s"
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "id": 4,
        "title": "Unique IPs",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "rawSql": "SELECT SUM(unique_ips) as value FROM dstreambolt_metrics.status_summary WHERE window_start >= NOW() - INTERVAL 1 HOUR",
            "format": "table",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "blue"}
              ]
            },
            "unit": "short"
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "id": 5,
        "title": "Requests Per Minute",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "rawSql": "SELECT window_start as time, SUM(request_count) as value FROM dstreambolt_metrics.status_summary WHERE window_start >= NOW() - INTERVAL 1 HOUR GROUP BY window_start ORDER BY window_start",
            "format": "time_series",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisLabel": "Requests",
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10,
              "showPoints": "auto"
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 6,
        "title": "Error Rate % Over Time",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "rawSql": "SELECT window_start as time, (SUM(error_count) * 100.0 / SUM(request_count)) as value FROM dstreambolt_metrics.status_summary WHERE window_start >= NOW() - INTERVAL 1 HOUR GROUP BY window_start ORDER BY window_start",
            "format": "time_series",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "custom": {
              "axisLabel": "Error %",
              "drawStyle": "line",
              "fillOpacity": 20
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            },
            "unit": "percent"
          }
        }
      },
      {
        "id": 7,
        "title": "Status Code Distribution",
        "type": "piechart",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12},
        "targets": [
          {
            "rawSql": "SELECT status as metric, SUM(request_count) as value FROM dstreambolt_metrics.status_summary WHERE window_start >= NOW() - INTERVAL 1 HOUR GROUP BY status ORDER BY value DESC",
            "format": "table",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]},
          "pieType": "pie",
          "tooltip": {"mode": "single"}
        }
      },
      {
        "id": 8,
        "title": "Requests by Status Code",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 16, "x": 8, "y": 12},
        "targets": [
          {
            "rawSql": "SELECT window_start as time, status, SUM(request_count) as value FROM dstreambolt_metrics.status_summary WHERE window_start >= NOW() - INTERVAL 1 HOUR GROUP BY window_start, status ORDER BY window_start",
            "format": "time_series",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 0,
              "showPoints": "auto"
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 9,
        "title": "Response Time Statistics",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "rawSql": "SELECT window_start as time, AVG(avg_response_time) as 'Average', AVG(max_response_time) as 'Max', AVG(min_response_time) as 'Min' FROM dstreambolt_metrics.status_summary WHERE window_start >= NOW() - INTERVAL 1 HOUR GROUP BY window_start ORDER BY window_start",
            "format": "time_series",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "axisLabel": "Response Time",
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 0
            },
            "unit": "s"
          }
        }
      },
      {
        "id": 10,
        "title": "Top 10 Slowest Endpoints",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "rawSql": "SELECT endpoint, method, ROUND(AVG(avg_response_time), 3) as avg_time, ROUND(AVG(p95_response_time), 3) as p95_time, ROUND(AVG(p99_response_time), 3) as p99_time, SUM(request_count) as requests FROM dstreambolt_metrics.endpoint_summary WHERE window_start >= NOW() - INTERVAL 1 HOUR GROUP BY endpoint, method ORDER BY avg_time DESC LIMIT 10",
            "format": "table",
            "refId": "A"
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": [{"displayName": "avg_time", "desc": true}]
        }
      },
      {
        "id": 11,
        "title": "Top 10 Most Requested Endpoints",
        "type": "barchart",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
        "targets": [
          {
            "rawSql": "SELECT CONCAT(method, ' ', endpoint) as metric, SUM(request_count) as value FROM dstreambolt_metrics.endpoint_summary WHERE window_start >= NOW() - INTERVAL 1 HOUR GROUP BY endpoint, method ORDER BY value DESC LIMIT 10",
            "format": "table",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "showValue": "always",
          "legend": {"displayMode": "hidden"}
        }
      },
      {
        "id": 12,
        "title": "Endpoints with Most Errors",
        "type": "table",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
        "targets": [
          {
            "rawSql": "SELECT endpoint, method, SUM(error_count) as total_errors, SUM(request_count) as total_requests, ROUND((SUM(error_count) * 100.0 / SUM(request_count)), 2) as error_rate FROM dstreambolt_metrics.endpoint_summary WHERE window_start >= NOW() - INTERVAL 1 HOUR AND error_count > 0 GROUP BY endpoint, method ORDER BY total_errors DESC LIMIT 10",
            "format": "table",
            "refId": "A"
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": [{"displayName": "total_errors", "desc": true}]
        }
      },
      {
        "id": 13,
        "title": "Endpoint Performance Over Time",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 36},
        "targets": [
          {
            "rawSql": "SELECT window_start as time, endpoint, AVG(avg_response_time) as value FROM dstreambolt_metrics.endpoint_summary WHERE window_start >= NOW() - INTERVAL 1 HOUR GROUP BY window_start, endpoint ORDER BY window_start LIMIT 500",
            "format": "time_series",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "palette-classic"},
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 0
            },
            "unit": "s"
          }
        }
      },
      {
        "id": 14,
        "title": "Error Details (Status >= 400)",
        "type": "table",
        "gridPos": {"h": 10, "w": 24, "x": 0, "y": 44},
        "targets": [
          {
            "rawSql": "SELECT window_start, endpoint, method, SUM(error_count) as errors, ROUND(AVG(avg_response_time), 3) as avg_time FROM dstreambolt_metrics.endpoint_summary WHERE error_count > 0 AND window_start >= NOW() - INTERVAL 1 HOUR GROUP BY window_start, endpoint, method ORDER BY errors DESC, window_start DESC LIMIT 50",
            "format": "table",
            "refId": "A"
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": [{"displayName": "errors", "desc": true}]
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    }
  },
  "overwrite": true
}

