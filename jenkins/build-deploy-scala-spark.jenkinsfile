pipeline {
    agent any

    parameters {
        string(name: 'SPARK_MASTER_IPS', defaultValue: '13.127.201.0', description: 'Comma-separated Spark master IPs')
        string(name: 'GIT_BRANCH', defaultValue: 'main', description: 'Git branch to build')
        string(name: 'REMOTE_USER', defaultValue: 'ubuntu', description: 'SSH username')
        string(name: 'KAFKA_BROKER', defaultValue: '10.0.10.101:9092', description: 'Kafka broker')
        choice(name: 'PROCESSING_MODE', choices: ['batch', 'streaming'], description: 'Processing mode')
        string(name: 'SPARK_DRIVER_MEMORY', defaultValue: '512m', description: 'Driver memory')
        string(name: 'SPARK_EXECUTOR_MEMORY', defaultValue: '512m', description: 'Executor memory')
        string(name: 'SPARK_DRIVER_PORT', defaultValue: '39499', description: 'Driver port')
        booleanParam(name: 'AUTO_START', defaultValue: true, description: 'Start job after deployment')
        booleanParam(name: 'CLEAN_BUILD', defaultValue: false, description: 'Clean build from scratch')
    }

    environment {
        REPO_URL = 'git@github.com:dstreambolt/dstream_cloud.git'
        GIT_SSH_CREDENTIAL = 'jenkins-github-ssh'
        SSH_CREDENTIAL_ID = 'dstreambolt-accesskey'

        // Paths on remote Spark nodes
        SPARK_HOME = '/opt/spark'
        DEPLOY_PATH = '/opt/dstreambolt/computations'
        SPARK_LOGS = '/opt/spark/logs'

        // Build paths (on Jenkins node)
        WORKSPACE_COMPUTATIONS = "${WORKSPACE}/computations"
        SBT_OPTS = '-Xmx1024m -Xss2m'
    }

    tools {
        // If SBT is configured as a Jenkins tool
        // sbt 'sbt-1.9.7'
    }

    stages {

        stage('Validate') {
            steps {
                script {
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                    echo "🎯 SCALA SPARK JOB BUILD & DEPLOY"
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                    echo "Branch: ${params.GIT_BRANCH}"
                    echo "Targets: ${params.SPARK_MASTER_IPS}"
                    echo "Mode: ${params.PROCESSING_MODE}"
                    echo "Kafka: ${params.KAFKA_BROKER}"
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

                    if (!params.SPARK_MASTER_IPS) {
                        error("❌ SPARK_MASTER_IPS is required!")
                    }

                    env.IP_LIST = params.SPARK_MASTER_IPS.replaceAll(/\s+/, '')
                }
            }
        }

        stage('Checkout') {
            steps {
                echo "📥 Checking out ${params.GIT_BRANCH}..."
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${params.GIT_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: env.REPO_URL,
                        credentialsId: env.GIT_SSH_CREDENTIAL
                    ]]
                ])

                script {
                    env.GIT_COMMIT = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    echo "✅ Commit: ${env.GIT_COMMIT}"
                }
            }
        }

        stage('Check SBT') {
            steps {
                script {
                    echo "🔍 Checking for SBT..."
                    def sbtExists = sh(script: "command -v sbt", returnStatus: true) == 0

                    if (!sbtExists) {
                        echo "⚠️  SBT not found. Installing..."
                        sh '''
                            # Install SBT
                            echo "deb https://repo.scala-sbt.org/scalasbt/debian all main" | sudo tee /etc/apt/sources.list.d/sbt.list
                            echo "deb https://repo.scala-sbt.org/scalasbt/debian /" | sudo tee /etc/apt/sources.list.d/sbt_old.list
                            curl -sL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x2EE0EA64E40A89B84B2DF73499E82A75642AC823" | sudo apt-key add
                            sudo apt-get update -qq
                            sudo apt-get install -y sbt
                        '''
                    }

                    sh "sbt --version"
                    echo "✅ SBT is available"
                }
            }
        }

        stage('Build Scala JAR') {
            steps {
                dir('computations') {
                    script {
                        echo "🔨 Building Scala Spark processor..."

                        if (params.CLEAN_BUILD) {
                            echo "🧹 Clean build requested..."
                            sh "sbt clean"
                        }

                        echo "📦 Compiling and packaging JAR..."
                        sh """
                            export SBT_OPTS="${env.SBT_OPTS}"
                            sbt assembly
                        """

                        // Verify JAR was created
                        def jarFile = sh(
                            script: "ls -t target/scala-2.12/dstreambolt-processor-*.jar | head -1",
                            returnStdout: true
                        ).trim()

                        if (!jarFile) {
                            error("❌ JAR file not found after build!")
                        }

                        env.JAR_FILE = jarFile
                        env.JAR_NAME = sh(script: "basename ${jarFile}", returnStdout: true).trim()

                        echo "✅ Built: ${env.JAR_NAME}"
                        sh "ls -lh ${env.JAR_FILE}"
                    }
                }
            }
        }

        stage('Create Deployment Package') {
            steps {
                dir('computations') {
                    script {
                        echo "📦 Creating deployment package..."

                        // Create deployment info
                        writeFile file: 'DEPLOY_INFO.txt', text: """
Deployment Information
======================
Job: ${JOB_NAME}
Build: ${BUILD_NUMBER}
Commit: ${env.GIT_COMMIT}
Branch: ${params.GIT_BRANCH}
JAR: ${env.JAR_NAME}
Built: ${new Date()}
Processing Mode: ${params.PROCESSING_MODE}
Kafka Broker: ${params.KAFKA_BROKER}
"""

                        // Create submission script
                        writeFile file: 'submit_job.sh', text: '''#!/bin/bash
set -e

SPARK_HOME="${SPARK_HOME:-/opt/spark}"
MASTER_URL="$1"
KAFKA_BROKER="$2"
MODE="$3"
DRIVER_MEM="$4"
EXECUTOR_MEM="$5"
DRIVER_PORT="$6"

# Get private IP
PRIVATE_IP=$(hostname -I | awk '{print $1}')

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🚀 Starting Scala Spark Job"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Master: $MASTER_URL"
echo "Kafka: $KAFKA_BROKER"
echo "Mode: $MODE"
echo "Driver Memory: $DRIVER_MEM"
echo "Executor Memory: $EXECUTOR_MEM"
echo "Driver Port: $DRIVER_PORT"
echo "Private IP: $PRIVATE_IP"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

JAR_FILE=$(ls -t *.jar 2>/dev/null | head -1)

if [ -z "$JAR_FILE" ]; then
    echo "❌ JAR file not found"
    exit 1
fi

echo "📦 Using JAR: $JAR_FILE"

$SPARK_HOME/bin/spark-submit \\
    --master "$MASTER_URL" \\
    --deploy-mode client \\
    --driver-memory "$DRIVER_MEM" \\
    --executor-memory "$EXECUTOR_MEM" \\
    --executor-cores 1 \\
    --total-executor-cores 2 \\
    --class com.dstreambolt.processor.SparkProcessor \\
    --conf spark.driver.port="$DRIVER_PORT" \\
    --conf spark.driver.host="$PRIVATE_IP" \\
    --conf spark.sql.streaming.forceDeleteTempCheckpointLocation=true \\
    --conf spark.streaming.stopGracefullyOnShutdown=true \\
    --conf spark.ui.enabled=true \\
    --conf spark.ui.port=4040 \\
    --conf spark.network.timeout=800s \\
    --conf spark.executor.heartbeatInterval=60s \\
    "$JAR_FILE" \\
    --spark-master "$MASTER_URL" \\
    --kafka-broker "$KAFKA_BROKER" \\
    --mode "$MODE"
'''

                        sh "chmod +x submit_job.sh"

                        // Create package
                        sh """
                            tar -czf ../scala-spark-job-${env.GIT_COMMIT}.tar.gz \\
                                ${env.JAR_NAME} \\
                                submit_job.sh \\
                                DEPLOY_INFO.txt
                        """

                        echo "✅ Package created: scala-spark-job-${env.GIT_COMMIT}.tar.gz"
                    }
                }
            }
        }

        stage('Stop Existing Jobs') {
            steps {
                script {
                    def ips = env.IP_LIST.split(',')

                    ips.each { ip ->
                        echo "⏹️  Stopping jobs on ${ip}..."

                        withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY')]) {
                            writeFile file: 'stop_spark_jobs.sh', text: '''#!/bin/bash
PIDS=$(pgrep -f "com.dstreambolt.processor.SparkProcessor" 2>/dev/null || true)

if [ -z "$PIDS" ]; then
    echo "✅ No running Scala Spark jobs found"
else
    echo "Found PIDs: $PIDS"
    kill -TERM $PIDS 2>/dev/null || true
    sleep 3
    kill -9 $(pgrep -f "com.dstreambolt.processor.SparkProcessor" 2>/dev/null || true) 2>/dev/null || true
    echo "✅ Stopped existing jobs"
fi
'''

                            sh """
                                scp -i \${SSH_KEY} -o StrictHostKeyChecking=no stop_spark_jobs.sh ${params.REMOTE_USER}@${ip}:/tmp/
                                ssh -i \${SSH_KEY} -o StrictHostKeyChecking=no ${params.REMOTE_USER}@${ip} 'bash /tmp/stop_spark_jobs.sh' || echo "⚠️  Warning: Could not stop jobs on ${ip}"
                            """
                        }
                    }
                }
            }
        }

        stage('Deploy to Spark Nodes') {
            steps {
                script {
                    def ips = env.IP_LIST.split(',')
                    def tasks = [:]

                    ips.each { ip ->
                        tasks[ip] = {
                            stage("Deploy → ${ip}") {
                                echo "📤 Deploying to ${ip}..."

                                withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY')]) {
                                    sh """
                                        # Transfer package
                                        scp -i \${SSH_KEY} -o StrictHostKeyChecking=no \\
                                            scala-spark-job-${env.GIT_COMMIT}.tar.gz \\
                                            ${params.REMOTE_USER}@${ip}:/tmp/
                                    """

                                    writeFile file: 'deploy_scala.sh', text: """#!/bin/bash
set -e

# Clean old deployment
rm -rf ${DEPLOY_PATH}/*

# Extract new deployment
cd ${DEPLOY_PATH}
tar -xzf /tmp/scala-spark-job-${env.GIT_COMMIT}.tar.gz

echo "✅ Deployed successfully"
ls -lh ${DEPLOY_PATH}/
cat ${DEPLOY_PATH}/DEPLOY_INFO.txt
"""

                                    sh """
                                        scp -i \${SSH_KEY} -o StrictHostKeyChecking=no deploy_scala.sh ${params.REMOTE_USER}@${ip}:/tmp/
                                        ssh -i \${SSH_KEY} -o StrictHostKeyChecking=no ${params.REMOTE_USER}@${ip} 'bash /tmp/deploy_scala.sh'
                                    """
                                }
                            }
                        }
                    }

                    parallel tasks
                }
            }
        }

        stage('Start Spark Jobs') {
            when {
                expression { params.AUTO_START == true }
            }
            steps {
                script {
                    def ips = env.IP_LIST.split(',')

                    ips.each { ip ->
                        echo "🚀 Starting job on ${ip}..."

                        withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY')]) {
                            writeFile file: 'start_spark_job.sh', text: """#!/bin/bash
set -e

# Get private IP for Spark master URL
PRIVATE_IP=\$(hostname -I | awk '{print \$1}')
MASTER_URL="spark://\$PRIVATE_IP:7077"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Master URL: \$MASTER_URL"
echo "Private IP: \$PRIVATE_IP"
echo "Driver Port: ${params.SPARK_DRIVER_PORT}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Start job in background
cd ${DEPLOY_PATH}

nohup ./submit_job.sh \\
    "\$MASTER_URL" \\
    "${params.KAFKA_BROKER}" \\
    "${params.PROCESSING_MODE}" \\
    "${params.SPARK_DRIVER_MEMORY}" \\
    "${params.SPARK_EXECUTOR_MEMORY}" \\
    "${params.SPARK_DRIVER_PORT}" \\
    > ${SPARK_LOGS}/scala-spark-job.log 2>&1 &

PID=\$!
echo \$PID > spark_job.pid

echo "✅ Job started (PID: \$PID)"
echo "📊 Spark Master UI: http://\$PRIVATE_IP:8080"
echo "📊 Application UI: http://\$PRIVATE_IP:4040"

# Wait and verify
sleep 3
if ps -p \$PID > /dev/null; then
    echo "✅ Job is running successfully"
else
    echo "❌ Job failed to start"
    tail -50 ${SPARK_LOGS}/scala-spark-job.log
    exit 1
fi
"""

                            sh """
                                scp -i \${SSH_KEY} -o StrictHostKeyChecking=no start_spark_job.sh ${params.REMOTE_USER}@${ip}:/tmp/
                                ssh -i \${SSH_KEY} -o StrictHostKeyChecking=no ${params.REMOTE_USER}@${ip} 'bash /tmp/start_spark_job.sh'
                            """
                        }
                    }
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                script {
                    def ips = env.IP_LIST.split(',')

                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                    echo "✅ DEPLOYMENT VERIFICATION"
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

                    ips.each { ip ->
                        withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY')]) {
                            writeFile file: 'verify_scala.sh', text: """#!/bin/bash
PRIVATE_IP=\$(hostname -I | awk '{print \$1}')

echo ""
echo "📊 Status on ${ip}:"
echo "─────────────────────────────────────────"

if [ -f ${DEPLOY_PATH}/spark_job.pid ]; then
    PID=\$(cat ${DEPLOY_PATH}/spark_job.pid)
    if ps -p \$PID > /dev/null 2>&1; then
        echo "✅ Job running (PID: \$PID)"
        echo "📊 Spark Master UI: http://\$PRIVATE_IP:8080"
        echo "📊 Application UI: http://\$PRIVATE_IP:4040"
        echo "📊 Driver Port: ${params.SPARK_DRIVER_PORT}"
    else
        echo "❌ Job not running"
    fi
else
    echo "⚠️  No PID file found"
fi

echo ""
echo "📁 Deployed files:"
ls -lh ${DEPLOY_PATH}/*.jar 2>/dev/null || echo "No JAR files found"

echo ""
echo "📋 Recent logs (last 30 lines):"
tail -30 ${SPARK_LOGS}/scala-spark-job.log 2>/dev/null || echo "No logs yet"
"""

                            sh """
                                scp -i \${SSH_KEY} -o StrictHostKeyChecking=no verify_scala.sh ${params.REMOTE_USER}@${ip}:/tmp/
                                ssh -i \${SSH_KEY} -o StrictHostKeyChecking=no ${params.REMOTE_USER}@${ip} 'bash /tmp/verify_scala.sh'
                            """
                        }
                    }

                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                }
            }
        }
    }

    post {
        success {
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo "✅ DEPLOYMENT COMPLETED SUCCESSFULLY"
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo "📌 Commit: ${env.GIT_COMMIT}"
            echo "🎯 Targets: ${env.IP_LIST}"
            echo "📦 JAR: ${env.JAR_NAME}"
        }

        failure {
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo "❌ DEPLOYMENT FAILED"
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo "Check logs above for details"
        }

        always {
            // Archive the built JAR
            archiveArtifacts artifacts: "scala-spark-job-${env.GIT_COMMIT}.tar.gz", allowEmptyArchive: true

            // Clean workspace
            cleanWs()
        }
    }
}

