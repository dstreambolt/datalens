pipeline {
    agent any

    parameters {
        string(name: 'SPARK_MASTER_IPS', defaultValue: '10.0.1.123', description: 'Comma-separated Spark master IPs')
        string(name: 'GIT_BRANCH', defaultValue: 'release/v1.0.0')
        string(name: 'REMOTE_USER', defaultValue: 'ubuntu')
        string(name: 'KAFKA_BROKER', defaultValue: '10.0.10.101:9092')
        choice(name: 'PROCESSING_MODE', choices: ['streaming', 'batch'])
        booleanParam(name: 'AUTO_START', defaultValue: false)
        string(name: 'SPARK_DRIVER_PORT', defaultValue: '39499')
        string(name: 'INSTANCE_TYPE', defaultValue: 't3.small', description: 'Optional: specify instance type (t3.small, t3.medium, t3.large) to override auto-detection)')
    }

    environment {
        REPO_URL = 'git@github.com:dstreambolt/dstream_cloud.git'
        SPARK_HOME = '/opt/spark'
        DEPLOY_PATH = '/opt/dstreambolt/computations'
        SPARK_JARS_DIR = '/opt/spark/jars'
        SPARK_LOGS = '/opt/spark/logs'
        GIT_SSH_CREDENTIAL = 'jenkins-github-ssh'
        SSH_CREDENTIAL_ID = 'dstreambolt-accesskey'
    }

    stages {
        stage('Validate') {
            steps {
                script {
                    if (!params.SPARK_MASTER_IPS) error("❌ SPARK_MASTER_IPS is required!")
                    env.IP_LIST = params.SPARK_MASTER_IPS.replaceAll(/\s+/, '')
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                    echo "🎯 Deployment Configuration"
                    echo "Target IPs: ${env.IP_LIST}"
                    echo "Branch: ${params.GIT_BRANCH}"
                    echo "Mode: ${params.PROCESSING_MODE}"
                    echo "Kafka: ${params.KAFKA_BROKER}"
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                }
            }
        }

        stage('Checkout') {
            steps {
                echo "📥 Checking out ${params.GIT_BRANCH}..."
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${params.GIT_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: env.REPO_URL,
                        credentialsId: env.GIT_SSH_CREDENTIAL
                    ]]
                ])
                script {
                    env.GIT_COMMIT = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    echo "✅ Commit: ${env.GIT_COMMIT}"
                }
            }
        }

        stage('Validate Code') {
            steps {
                dir('computations') {
                    sh '''
                        echo "🔍 Validating Spark code..."
                        if [ ! -f spark_processor.py ]; then
                            echo "❌ spark_processor.py not found!"; exit 1
                        fi
                        python3 -m py_compile spark_processor.py || { echo "❌ Python syntax error!"; exit 1; }
                        if [ ! -f requirements.txt ]; then
                            echo "❌ requirements.txt not found!"; exit 1
                        fi
                        echo "✅ Code validation passed"
                    '''
                }
            }
        }

        stage('Package') {
            steps {
                sh '''
                    echo "📦 Creating deployment package..."
                    rm -rf deploy_package
                    mkdir -p deploy_package
                    cp -r computations/* deploy_package/

                    cat > deploy_package/submit_job.sh << 'EOFSCRIPT'
#!/bin/bash
set -e

MASTER_URL="$1"
KAFKA="$2"
MODE="$3"
# Hard-set for t3.small (shared master/worker) minimal config!
DRIVER_MEM="550m"
EXEC_MEM="512m"
DRIVER_PORT="${6:-39499}"
EXEC_CORES="${7:-1}"
TOTAL_EXEC_CORES="${8:-1}"
SHUFFLE_PARTITIONS=1
PARALLELISM=1

echo "t3.small MINIMAL: driver-memory=$DRIVER_MEM executor-memory=$EXEC_MEM shuffle_partitions=$SHUFFLE_PARTITIONS parallelism=$PARALLELISM"

exec /opt/spark/bin/spark-submit \
    --master "$MASTER_URL" \
    --deploy-mode client \
    --driver-memory "$DRIVER_MEM" \
    --executor-memory "$EXEC_MEM" \
    --executor-cores "$EXEC_CORES" \
    --total-executor-cores "$TOTAL_EXEC_CORES" \
    --packages org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.0 \
    --conf spark.driver.port="$DRIVER_PORT" \
    --conf spark.driver.host=$(hostname -I | awk '{print $1}') \
    --conf spark.sql.shuffle.partitions="$SHUFFLE_PARTITIONS" \
    --conf spark.default.parallelism="$PARALLELISM" \
    --conf spark.sql.streaming.forceDeleteTempCheckpointLocation=true \
    --conf spark.streaming.stopGracefullyOnShutdown=true \
    --conf spark.ui.enabled=true \
    --conf spark.executor.extraJavaOptions="-XX:+UseG1GC" \
    --conf spark.driver.extraJavaOptions="-XX:+UseG1GC" \
    --conf spark.network.timeout=600s \
    --conf spark.executor.heartbeatInterval=120s \
    /opt/dstreambolt/computations/spark_processor.py \
    --spark-master "$MASTER_URL" \
    --kafka-broker "$KAFKA" \
    --mode "$MODE"
EOFSCRIPT

                    chmod +x deploy_package/submit_job.sh
                    cd deploy_package
                    tar -czf ../spark-job-${GIT_COMMIT}.tar.gz .
                    echo "✅ Package: spark-job-${GIT_COMMIT}.tar.gz"
                '''
            }
        }

        stage('Stop Existing Jobs') {
            steps {
                script {
                    env.IP_LIST.split(',').each { ip ->
                        echo "⏹️ Stopping jobs on ${ip}..."
                        withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY')]) {
                            writeFile file: 'stop_spark_jobs.sh', text: '''#!/bin/bash
PIDS=$(pgrep -f "spark_processor.py" 2>/dev/null || true)
[ -z "$PIDS" ] && echo "✅ No running jobs" || { echo "Killing PIDs: $PIDS"; kill -TERM $PIDS 2>/dev/null || true; sleep 3; kill -9 $(pgrep -f "spark_processor.py" 2>/dev/null || true) 2>/dev/null || true; echo "✅ Stopped jobs"; }
'''
                            sh """
                                scp -i \${SSH_KEY} -o StrictHostKeyChecking=no stop_spark_jobs.sh ${params.REMOTE_USER}@${ip}:/tmp/
                                ssh -i \${SSH_KEY} -o StrictHostKeyChecking=no ${params.REMOTE_USER}@${ip} 'bash /tmp/stop_spark_jobs.sh' || echo "⚠️ Could not stop jobs"
                            """
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    env.IP_LIST.split(',').each { ip ->
                        echo "📤 Deploying to ${ip}..."
                        withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY')]) {
                            writeFile file: 'deploy_spark.sh', text: """#!/bin/bash
set -e
rm -rf ${env.DEPLOY_PATH}/*
cd ${env.DEPLOY_PATH}
tar -xzf /tmp/spark-job-${env.GIT_COMMIT}.tar.gz
if [ ! -d venv ]; then python3 -m venv venv; fi
source venv/bin/activate
pip install -q --upgrade pip
pip install -q -r requirements.txt
echo "✅ Deployed successfully"
"""
                            sh """
                                scp -i \${SSH_KEY} -o StrictHostKeyChecking=no spark-job-${env.GIT_COMMIT}.tar.gz ${params.REMOTE_USER}@${ip}:/tmp/
                                scp -i \${SSH_KEY} -o StrictHostKeyChecking=no deploy_spark.sh ${params.REMOTE_USER}@${ip}:/tmp/
                                ssh -i \${SSH_KEY} -o StrictHostKeyChecking=no ${params.REMOTE_USER}@${ip} 'bash /tmp/deploy_spark.sh'
                            """
                        }
                    }
                }
            }
        }

        stage('Start Jobs') {
            when { expression { params.AUTO_START } }
            steps {
                script {
                    env.IP_LIST.split(',').each { ip ->
                        echo "🚀 Starting job on ${ip}..."
                        withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY')]) {
                            writeFile file: 'start_spark_job.sh', text: """#!/bin/bash
set -e

PRIVATE_IP=\$(hostname -I | awk '{print \$1}')
MASTER_URL="spark://\$PRIVATE_IP:7077"

# Absolutely minimal for t3.small master+executor
DRIVER_MEM="550m"
EXEC_MEM="512m"
EXEC_CORES=1
TOTAL_EXEC_CORES=1
SHUFFLE_PARTITIONS=1
PARALLELISM=1

echo "t3.small MINIMAL: driver-memory=\$DRIVER_MEM executor-memory=\$EXEC_MEM shuffle_partitions=\$SHUFFLE_PARTITIONS parallelism=\$PARALLELISM"

cd ${env.DEPLOY_PATH}
source venv/bin/activate

nohup ./submit_job.sh "\$MASTER_URL" "${params.KAFKA_BROKER}" "${params.PROCESSING_MODE}" "\$DRIVER_MEM" "\$EXEC_MEM" "${params.SPARK_DRIVER_PORT}" "\$EXEC_CORES" "\$TOTAL_EXEC_CORES" "\$SHUFFLE_PARTITIONS" "\$PARALLELISM" > /opt/spark/logs/spark-job.log 2>&1 &

PID=\$!
sleep 3
if ps -p \$PID > /dev/null; then
    echo \$PID > spark_job.pid
    echo "✅ Job started (PID: \$PID)"
else
    echo "❌ Job failed to start"
    tail -50 /opt/spark/logs/spark-job.log
    exit 1
fi
"""
                            sh """
                                scp -i \${SSH_KEY} -o StrictHostKeyChecking=no start_spark_job.sh ${params.REMOTE_USER}@${ip}:/tmp/
                                ssh -i \${SSH_KEY} -o StrictHostKeyChecking=no ${params.REMOTE_USER}@${ip} 'bash /tmp/start_spark_job.sh'
                            """
                        }
                    }
                }
            }
        }

        stage('Verify') {
            steps {
                script {
                    env.IP_LIST.split(',').each { ip ->
                        withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY')]) {
                            writeFile file: 'verify_spark.sh', text: """#!/bin/bash
PRIVATE_IP=\$(hostname -I | awk '{print \$1}')
if [ -f ${env.DEPLOY_PATH}/spark_job.pid ]; then
    PID=\$(cat ${env.DEPLOY_PATH}/spark_job.pid)
    if ps -p \$PID > /dev/null 2>&1; then
        echo "✅ Job running (PID: \$PID)"
        echo "📊 Spark Master UI: http://\$PRIVATE_IP:8080"
        echo "📊 Application UI: http://\$PRIVATE_IP:4040"
        echo "📊 Driver Port: ${params.SPARK_DRIVER_PORT}"
    else
        echo "❌ Job not running"
    fi
else
    echo "⚠️ No PID file found"
fi
echo ""
echo "Recent logs (last 30 lines):"
tail -30 /opt/spark/logs/spark-job.log 2>/dev/null || echo "No logs yet"
"""
                            sh """
                                scp -i \${SSH_KEY} -o StrictHostKeyChecking=no verify_spark.sh ${params.REMOTE_USER}@${ip}:/tmp/
                                ssh -i \${SSH_KEY} -o StrictHostKeyChecking=no ${params.REMOTE_USER}@${ip} 'bash /tmp/verify_spark.sh'
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ DEPLOYMENT SUCCESSFUL"
            echo "Commit: ${env.GIT_COMMIT}"
            echo "Targets: ${env.IP_LIST}"
        }
        failure {
            echo "❌ DEPLOYMENT FAILED"
        }
        always {
            archiveArtifacts artifacts: "spark-job-${env.GIT_COMMIT}.tar.gz", allowEmptyArchive: true
            cleanWs()
        }
    }
}