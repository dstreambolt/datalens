pipeline {
    agent any

    parameters {
        string(name: 'SPARK_MASTER_IPS', defaultValue: '13.127.201.0', description: 'Comma-separated Spark master IPs')
        string(name: 'GIT_BRANCH', defaultValue: 'main', description: 'Git branch to deploy')
        string(name: 'REMOTE_USER', defaultValue: 'ubuntu', description: 'SSH username')
        string(name: 'KAFKA_BROKER', defaultValue: '10.0.10.101:9092', description: 'Kafka broker')
        choice(name: 'PROCESSING_MODE', choices: ['batch', 'streaming'], description: 'Processing mode')
        string(name: 'SPARK_DRIVER_MEMORY', defaultValue: '512m', description: 'Driver memory')
        string(name: 'SPARK_EXECUTOR_MEMORY', defaultValue: '512m', description: 'Executor memory')
        string(name: 'SPARK_DRIVER_PORT', defaultValue: '39499', description: 'Driver port')
        booleanParam(name: 'AUTO_START', defaultValue: true, description: 'Start job after deployment')
    }

    environment {
        REPO_URL = 'git@github.com:dstreambolt/dstream_cloud.git'
        GIT_SSH_CREDENTIAL = 'jenkins-github-ssh'
        SSH_CREDENTIAL_ID = 'dstreambolt-accesskey'

        // Paths on remote Spark nodes
        SPARK_HOME = '/opt/spark'
        DEPLOY_PATH = '/opt/dstreambolt/computations'
        SPARK_LOGS = '/opt/spark/logs'
    }

    stages {

        stage('Validate') {
            steps {
                script {
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                    echo "🎯 SCALA SPARK JAR DEPLOY (Pre-built)"
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                    echo "Branch: ${params.GIT_BRANCH}"
                    echo "Targets: ${params.SPARK_MASTER_IPS}"
                    echo "Mode: ${params.PROCESSING_MODE}"
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

                    if (!params.SPARK_MASTER_IPS) {
                        error("❌ SPARK_MASTER_IPS is required!")
                    }

                    env.IP_LIST = params.SPARK_MASTER_IPS.replaceAll(/\s+/, '')
                }
            }
        }

        stage('Checkout') {
            steps {
                echo "📥 Checking out ${params.GIT_BRANCH}..."
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "*/${params.GIT_BRANCH}"]],
                    userRemoteConfigs: [[
                        url: env.REPO_URL,
                        credentialsId: env.GIT_SSH_CREDENTIAL
                    ]]
                ])

                script {
                    env.GIT_COMMIT = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    echo "✅ Commit: ${env.GIT_COMMIT}"
                }
            }
        }

        stage('Find Pre-built JAR') {
            steps {
                dir('computations') {
                    script {
                        echo "🔍 Looking for pre-built JAR..."

                        // Look for JAR in target directory (should be committed or uploaded)
                        def jarFile = sh(
                            script: "find . -name 'dstreambolt-processor-*.jar' -type f | head -1",
                            returnStdout: true
                        ).trim()

                        if (!jarFile) {
                            error("""
❌ No pre-built JAR found!

Please build the JAR locally and commit it:
  cd computations
  sbt assembly
  git add target/scala-2.12/dstreambolt-processor-*.jar
  git commit -m "Add pre-built JAR"
  git push

Or use the local build script:
  ./build_and_upload.sh
""")
                        }

                        env.JAR_FILE = jarFile
                        env.JAR_NAME = sh(script: "basename ${jarFile}", returnStdout: true).trim()

                        echo "✅ Found JAR: ${env.JAR_NAME}"
                        sh "ls -lh ${env.JAR_FILE}"
                    }
                }
            }
        }

        stage('Create Deployment Package') {
            steps {
                dir('computations') {
                    script {
                        echo "📦 Creating deployment package..."

                        writeFile file: 'DEPLOY_INFO.txt', text: """
Deployment Information
======================
Job: ${JOB_NAME}
Build: ${BUILD_NUMBER}
Commit: ${env.GIT_COMMIT}
Branch: ${params.GIT_BRANCH}
JAR: ${env.JAR_NAME}
Deployed: ${new Date()}
Processing Mode: ${params.PROCESSING_MODE}
Kafka Broker: ${params.KAFKA_BROKER}
"""

                        writeFile file: 'submit_job.sh', text: '''#!/bin/bash
set -e

SPARK_HOME="${SPARK_HOME:-/opt/spark}"
MASTER_URL="$1"
KAFKA_BROKER="$2"
MODE="$3"
DRIVER_MEM="$4"
EXECUTOR_MEM="$5"
DRIVER_PORT="$6"

PRIVATE_IP=$(hostname -I | awk '{print $1}')

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🚀 Starting Scala Spark Job"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Master: $MASTER_URL"
echo "Kafka: $KAFKA_BROKER"
echo "Mode: $MODE"
echo "Driver Memory: $DRIVER_MEM"
echo "Executor Memory: $EXECUTOR_MEM"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

JAR_FILE=$(ls -t *.jar 2>/dev/null | head -1)

if [ -z "$JAR_FILE" ]; then
    echo "❌ JAR file not found"
    exit 1
fi

echo "📦 Using JAR: $JAR_FILE"

$SPARK_HOME/bin/spark-submit \\
    --master "$MASTER_URL" \\
    --deploy-mode client \\
    --driver-memory "$DRIVER_MEM" \\
    --executor-memory "$EXECUTOR_MEM" \\
    --executor-cores 1 \\
    --total-executor-cores 2 \\
    --class com.dstreambolt.processor.SparkProcessor \\
    --conf spark.driver.port="$DRIVER_PORT" \\
    --conf spark.driver.host="$PRIVATE_IP" \\
    --conf spark.sql.streaming.forceDeleteTempCheckpointLocation=true \\
    --conf spark.streaming.stopGracefullyOnShutdown=true \\
    --conf spark.ui.enabled=true \\
    --conf spark.ui.port=4040 \\
    "$JAR_FILE" \\
    --spark-master "$MASTER_URL" \\
    --kafka-broker "$KAFKA_BROKER" \\
    --mode "$MODE"
'''

                        sh "chmod +x submit_job.sh"

                        sh """
                            tar -czf ../scala-spark-job-${env.GIT_COMMIT}.tar.gz \\
                                ${env.JAR_NAME} \\
                                submit_job.sh \\
                                DEPLOY_INFO.txt
                        """

                        echo "✅ Package created: scala-spark-job-${env.GIT_COMMIT}.tar.gz"
                    }
                }
            }
        }

        stage('Stop Existing Jobs') {
            steps {
                script {
                    def ips = env.IP_LIST.split(',')

                    ips.each { ip ->
                        echo "⏹️  Stopping jobs on ${ip}..."

                        withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY')]) {
                            sh """
                                ssh -i \${SSH_KEY} -o StrictHostKeyChecking=no ${params.REMOTE_USER}@${ip} '
                                    PIDS=\$(pgrep -f "com.dstreambolt.processor.SparkProcessor" 2>/dev/null || true)
                                    if [ ! -z "\$PIDS" ]; then
                                        echo "Stopping PIDs: \$PIDS"
                                        kill -TERM \$PIDS 2>/dev/null || true
                                        sleep 3
                                        kill -9 \$(pgrep -f "com.dstreambolt.processor.SparkProcessor" 2>/dev/null || true) 2>/dev/null || true
                                    else
                                        echo "No running jobs found"
                                    fi
                                ' || echo "⚠️  Warning: Could not stop jobs on ${ip}"
                            """
                        }
                    }
                }
            }
        }

        stage('Deploy to Spark Nodes') {
            steps {
                script {
                    def ips = env.IP_LIST.split(',')
                    def tasks = [:]

                    ips.each { ip ->
                        tasks[ip] = {
                            stage("Deploy → ${ip}") {
                                echo "📤 Deploying to ${ip}..."

                                withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY')]) {
                                    sh """
                                        scp -i \${SSH_KEY} -o StrictHostKeyChecking=no \\
                                            scala-spark-job-${env.GIT_COMMIT}.tar.gz \\
                                            ${params.REMOTE_USER}@${ip}:/tmp/
                                    """

                                    sh """
                                        ssh -i \${SSH_KEY} -o StrictHostKeyChecking=no ${params.REMOTE_USER}@${ip} '
                                            set -e
                                            rm -rf ${DEPLOY_PATH}/*
                                            cd ${DEPLOY_PATH}
                                            tar -xzf /tmp/scala-spark-job-${env.GIT_COMMIT}.tar.gz
                                            echo "✅ Deployed successfully"
                                            ls -lh ${DEPLOY_PATH}/
                                            cat ${DEPLOY_PATH}/DEPLOY_INFO.txt
                                        '
                                    """
                                }
                            }
                        }
                    }

                    parallel tasks
                }
            }
        }

        stage('Start Spark Jobs') {
            when {
                expression { params.AUTO_START == true }
            }
            steps {
                script {
                    def ips = env.IP_LIST.split(',')

                    ips.each { ip ->
                        echo "🚀 Starting job on ${ip}..."

                        withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY')]) {
                            sh """
                                ssh -i \${SSH_KEY} -o StrictHostKeyChecking=no ${params.REMOTE_USER}@${ip} '
                                    PRIVATE_IP=\$(hostname -I | awk "{print \\\$1}")
                                    MASTER_URL="spark://\$PRIVATE_IP:7077"

                                    echo "Master URL: \$MASTER_URL"

                                    cd ${DEPLOY_PATH}

                                    nohup ./submit_job.sh \\
                                        "\$MASTER_URL" \\
                                        "${params.KAFKA_BROKER}" \\
                                        "${params.PROCESSING_MODE}" \\
                                        "${params.SPARK_DRIVER_MEMORY}" \\
                                        "${params.SPARK_EXECUTOR_MEMORY}" \\
                                        "${params.SPARK_DRIVER_PORT}" \\
                                        > ${SPARK_LOGS}/scala-spark-job.log 2>&1 &

                                    PID=\$!
                                    echo \$PID > spark_job.pid

                                    echo "✅ Job started (PID: \$PID)"

                                    sleep 3
                                    if ps -p \$PID > /dev/null; then
                                        echo "✅ Job is running"
                                    else
                                        echo "❌ Job failed to start"
                                        tail -50 ${SPARK_LOGS}/scala-spark-job.log
                                        exit 1
                                    fi
                                '
                            """
                        }
                    }
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                script {
                    def ips = env.IP_LIST.split(',')

                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                    echo "✅ DEPLOYMENT VERIFICATION"
                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

                    ips.each { ip ->
                        withCredentials([sshUserPrivateKey(credentialsId: env.SSH_CREDENTIAL_ID, keyFileVariable: 'SSH_KEY')]) {
                            sh """
                                ssh -i \${SSH_KEY} -o StrictHostKeyChecking=no ${params.REMOTE_USER}@${ip} '
                                    PRIVATE_IP=\$(hostname -I | awk "{print \\\$1}")

                                    echo ""
                                    echo "📊 Status on ${ip}:"
                                    echo "─────────────────────────────────────────"

                                    if [ -f ${DEPLOY_PATH}/spark_job.pid ]; then
                                        PID=\$(cat ${DEPLOY_PATH}/spark_job.pid)
                                        if ps -p \$PID > /dev/null 2>&1; then
                                            echo "✅ Job running (PID: \$PID)"
                                            echo "📊 Spark Master UI: http://\$PRIVATE_IP:8080"
                                            echo "📊 Application UI: http://\$PRIVATE_IP:4040"
                                        else
                                            echo "❌ Job not running"
                                        fi
                                    else
                                        echo "⚠️  No PID file"
                                    fi

                                    echo ""
                                    echo "📄 Recent logs (last 20 lines):"
                                    tail -20 ${SPARK_LOGS}/scala-spark-job.log 2>/dev/null || echo "No logs yet"
                                '
                            """
                        }
                    }

                    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                }
            }
        }
    }

    post {
        success {
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo "✅ DEPLOYMENT COMPLETED SUCCESSFULLY"
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo "📌 Commit: ${env.GIT_COMMIT}"
            echo "🎯 Targets: ${env.IP_LIST}"
            echo "📦 JAR: ${env.JAR_NAME}"
        }

        failure {
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
            echo "❌ DEPLOYMENT FAILED"
            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        }

        always {
            archiveArtifacts artifacts: "scala-spark-job-${env.GIT_COMMIT}.tar.gz", allowEmptyArchive: true
            cleanWs()
        }
    }
}

